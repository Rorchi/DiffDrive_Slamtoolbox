<!-- Çoklu hedef arayüzü de aynı sınırlı bekleme davranışını kullanır. -->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="2" name="NavigateWithWait">
      <PipelineSequence name="PlanAndFollow">
        <RateController hz="1.0">
          <Sequence>
            <RemovePassedGoals input_goals="{goals}" output_goals="{goals}" radius="0.12"/>
            <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="GridBased"/>
          </Sequence>
        </RateController>
        <FollowPath path="{path}" controller_id="FollowPath" goal_checker_id="goal_checker"/>
      </PipelineSequence>
      <Wait wait_duration="2.0"/>
    </RecoveryNode>
  </BehaviorTree>
</root>
