<?xml version="1.0"?>
<!--
Amaç: RGB kamera gövdesini, optik çerçevesini ve simülasyon ayarlarını tanımlar.
Çalışma: Kamerayı chassis üzerine sabitler ve optik eksen dönüşümünü ayrı eklemle
kurar. Gazebo kamera tanımı 640×480 görüntü, 30 Hz yenileme ve görüş
mesafesi parametrelerini belirler.
-->

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <joint name="camera_joint" type="fixed">
    <parent link="chassis"/>
    <child link="camera_frame"/>
    <origin xyz="-0.015 0 0.1065" rpy="0 ${-pi/2} ${pi/2}"/>
  </joint>
<!--!rpy="0 ${-pi/2} ${pi/2} -->
  <link name="camera_frame">
    <visual>
      <geometry>
        <box size="0.053 0.03 0.036"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <geometry>
        <box size="0.053 0.03 0.036"/>
      </geometry>
    </collision>

  </link>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_frame"/>
    <child link="camera_link_optical"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <link name="camera_link_optical"/>

  <gazebo reference="camera_frame">
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="camera_link_optical">
    <sensor name="rgb_camera" type="camera">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <topic>camera</topic>

      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>8.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

</robot>