<?xml version="1.0"?>
<!--
Amaç: Robot parçalarının ortak renk malzemelerini tanımlar.
Çalışma: Diğer Xacro dosyaları burada adlandırılan RGBA malzemelerini visual
öğelerinde kullanarak modelin renklerini belirler.
-->

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="blue">
    <color rgba="0.1 0.3 0.8 1.0"/>
  </material>

  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

  <material name="gray">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>

  <material name="dark_gray">
    <color rgba="0.3 0.3 0.3 1.0"/>
  </material>

  <material name="red">
    <color rgba="0.8 0.1 0.1 1.0"/>
  </material>

</robot>