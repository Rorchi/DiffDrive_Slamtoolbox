<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">


<!--sol on teker-->

<joint name="left_front_wheel_joint" type="continuous">
  <parent link="base_link"/>
  <child link="left_front_wheel"/>
  <origin xyz="0 0.1 0" rpy="-${pi/2} 0 0"/>
  <axis xyz="0 0 1"/>
</joint>


<link name="left_front_wheel">
  <visual>
    <origin xyz="0 0 0"/>
    <geometry>
      <cylinder radius="0.04" length="0.04"/>
    </geometry>
    <material name="gray"/>
  </visual>

  <collision>
    <origin xyz="0 0 0"/>
    <geometry>
      <cylinder radius="0.04" length="0.04"/>
    </geometry>
    <material name="gray"/>
  </collision>


</link>
<gazebo reference="left_front_wheel">
    <material>Gazebo/Gray</material>
  </gazebo>


<!--sol arka teker-->

<joint name="left_rear_wheel_joint" type="continuous">
  <parent link="base_link"/>
  <child link="left_rear_wheel"/>
  <origin xyz="-0.13 0.1 0" rpy="-${pi/2} 0 0"/>
  <axis xyz="0 0 1"/>
</joint>


<link name="left_rear_wheel">
  <visual>
    <origin xyz="0 0 0"/>
    <geometry>
      <cylinder radius="0.04" length="0.04"/>
    </geometry>
    <material name="black"/>
  </visual>

  <collision>
    <origin xyz="0 0 0"/>
    <geometry>
      <cylinder radius="0.04" length="0.04"/>
    </geometry>
    <material name="black"/>
  </collision >


</link>

  <gazebo reference="left_rear_wheel">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
    <material>Gazebo/Black</material>
  </gazebo>
<!--sağ on teker-->

<joint name="right_front_wheel_joint" type="continuous">
  <parent link="base_link"/>
  <child link="right_front_wheel"/>
  <origin xyz="0 -0.1 0" rpy="${pi/2} 0 0"/>
  <axis xyz="0 0 -1"/>
</joint>


<link name="right_front_wheel">
  <visual>
    <origin xyz="0 0 0"/>
    <geometry>
      <cylinder radius="0.04" length="0.04"/>
    </geometry>
    <material name="gray"/>
  </visual>

  <collision>
    <origin xyz="0 0 0"/>
    <geometry>
      <cylinder radius="0.04" length="0.04"/>
    </geometry>
    <material name="gray"/>
  </collision>


</link>
 <gazebo reference="right_front_wheel">
    <material>Gazebo/Gray</material>
  </gazebo>

<!--sağ arka teker-->

<joint name="right_rear_wheel_joint" type="continuous">
  <parent link="base_link"/>
  <child link="right_rear_wheel"/>
  <origin xyz="-0.13 -0.1 0" rpy="${pi/2} 0 0"/>
  <axis xyz="0 0 -1"/>
</joint>


<link name="right_rear_wheel">
  <visual>
    <origin xyz="0 0 0"/>
    <geometry>
      <cylinder radius="0.04" length="0.04"/>
    </geometry>
    <material name="black"/>
  </visual>

  <collision>
    <origin xyz="0 0 0"/>
    <geometry>
      <cylinder radius="0.04" length="0.04"/>
    </geometry>
    <material name="black"/>
  </collision>
</link>

  <gazebo reference="right_rear_wheel">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
    <material>Gazebo/Black</material>
  </gazebo>

</robot>